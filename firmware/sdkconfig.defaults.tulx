# TULX32 overlay.  The user has no USB on this product and the bench reaches it
# over UART0 on the debug adapter, so the console must not sit on the
# USB-Serial-JTAG port the TUL stick uses — a TULX built that way is mute
# (bench 2026-09-15: nothing after the IDF start-up banner).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# IDF appends sdkconfig.defaults.esp32c6 for every C6 build, and that file
# carries the C6 EUL/TUL carrier's M24C32 config EEPROM.  The TULX never has
# one (Dirk 2026-09-21): no tile, and no I2C probe on GPIO 22/23 with the
# write-protect line on GPIO 15 driven as an output.
# CONFIG_CDC2NET_EEPROM_M24C32 is not set
