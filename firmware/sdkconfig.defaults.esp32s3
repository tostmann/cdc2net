# CDC2NET — ESP32-S3 overlay (YD-ESP32-S3, 16 MB).  USB-host bridge mission.
# Appended to sdkconfig.defaults automatically for the S3 build.

# ---- Mission: USB-host source (CDC-ACM + FTDI/CH34x/CP210x VCP) -----------
CONFIG_CDC2NET_SOURCE_USB=y

# ---- Flash ---------------------------------------------------------------
# Mode = DIO (NOT QIO).  QIO needs WP-/HOLD- as extra data lines; many cheap
# ESP32-S3 clones lack the WP pull and crash the 2nd-stage bootloader.  Do NOT
# paper over with an esptool --flash_mode override (the bootloader is still
# compiled QIO).  Read-speed halves but it's boot/OTA/coredump only.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- Console -------------------------------------------------------------
# Console on UART0 (CH343P bridge on the YD-ESP32-S3 programming port).  The S3
# USB-Serial-JTAG console shares the OTG PHY pins (GPIO19/20) we need for USB
# HOST mode, so the USB-JTAG console is unusable here.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ---- USB Host ------------------------------------------------------------
# Control-transfer max sized for CDC-ACM line-coding / SET_CONTROL_LINE_STATE
# (and small VCP vendor requests).
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=256

# ---- WiFi <-> USB PHY coexistence (LOAD-BEARING — esp-idf issue #15079) ---
# The S3 has ONE internal USB PHY shared by USB-OTG and USB-Serial-JTAG.  WiFi
# init AUTO-DISABLES the USB PHY for RF performance (S3 has the workaround SoC
# cap), which kills USB-host enumeration the instant WiFi associates.  Keep the
# PHY on.  This defaults to 'y' ONLY when the console is USB-Serial-JTAG; our
# console is UART0, so we must set it explicitly.
CONFIG_ESP_PHY_ENABLE_USB=y

# FreeRTOS per-task core-id column (S3 is dual-core).
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
