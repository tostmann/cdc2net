# ============================================================================
# CDC2NET MISSION_TBR — OpenThread Border Router config overlay (C6 native radio
# + W5500 backbone).  APPEND this to the build's SDKCONFIG_DEFAULTS when building
# with CONFIG_CDC2NET_MISSION_TBR=y (it is not auto-included by PlatformIO).
# Keys verified against the IDF 5.5.3 ot_br example on esp32c6.  Experimental.
# ============================================================================

CONFIG_CDC2NET_MISSION_TBR=y

# ---- OpenThread core + FTD + native radio + full border router -------------
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_BORDER_ROUTER=y
CONFIG_OPENTHREAD_NETWORK_AUTO_START=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_BORDER_AGENT_ENABLE=y
# Headless BR: no interactive CLI / ESP CLI extension / LED strip (keeps the
# build self-contained — no managed-component fetch).
# CONFIG_OPENTHREAD_CLI is not set
# CONFIG_OPENTHREAD_CLI_ESP_EXTENSION is not set
# CONFIG_OPENTHREAD_STATE_INDICATOR_ENABLE is not set
# default network params (auto_start forms a network without a peer = leader)
CONFIG_OPENTHREAD_NETWORK_NAME="OpenThread-ESP"
CONFIG_OPENTHREAD_NETWORK_CHANNEL=15
CONFIG_OPENTHREAD_NETWORK_PANID=0x1234

# ---- lwIP IPv6 + forwarding + the BR custom hooks --------------------------
# (net_eth.c brings up IPv6 link-local on the W5500 backbone under CONFIG_LWIP_IPV6.)
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_HOOK_IP6_INPUT_CUSTOM=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# ---- mbedtls (Thread MeshCoP commissioning: ECJPAKE + CMAC + DTLS) ---------
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
