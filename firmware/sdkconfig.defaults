# CDC2NET — COMMON sdkconfig defaults (chip-agnostic).
#
# Chip/mission-specific settings live in the per-target overlays
# sdkconfig.defaults.esp32s3 (USB-host bridge) and sdkconfig.defaults.esp32c6
# (EUL/TUL UART source + W5500).  IDF auto-appends sdkconfig.defaults.<IDF_TARGET>
# to this file (verified in framework-espidf tools/cmake/kconfig.cmake:179-185),
# so the right overlay is applied per board without PlatformIO passing it.
# Anything not listed anywhere uses IDF defaults.

# ---- Logging -------------------------------------------------------------
CONFIG_LOG_COLORS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- System observability (long-run) -------------------------------------
# Coredump-to-flash: a panic writes an ELF into the coredump partition;
# read via espcoredump.py or /api/coredump.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_LOGS=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32
CONFIG_ESP_COREDUMP_USE_STACK_SIZE=y
CONFIG_ESP_COREDUMP_STACK_SIZE=1024

# Task-WDT panic → coredump instead of log-and-continue.
CONFIG_ESP_TASK_WDT_PANIC=y
# Panic handler in IRAM so it runs even with the flash cache disabled.
CONFIG_ESP_PANIC_HANDLER_IRAM=y

# FreeRTOS trace-facility for the per-task stack-HWM overview.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# ---- LWIP ----------------------------------------------------------------
# Default 10 is tight once httpd:80 + the raw-TCP listener + fan-out clients +
# mdns/dhcp run concurrently.  16 gives headroom.
CONFIG_LWIP_MAX_SOCKETS=16
