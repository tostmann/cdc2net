# zbgw — ESP Thread-BR / Zigbee-GW board (ESP32-S3 host + ESP32-H2 radio).
#
# The H2 runs the full ZBOSS NCP (busware esp-coordinator) and reaches the S3
# over the board's inter-chip UART; the S3 is a byte-transparent UART->TCP
# bridge with the W5500 sub-board as its uplink.  So: UART source, not USB
# host — this fragment overrides the esp32s3 overlay's SOURCE_USB choice, the
# same way sdkconfig.defaults.cherry does.
CONFIG_CDC2NET_SOURCE_USB=n
CONFIG_CDC2NET_SOURCE_UART=y

# W5500 on the official "ESP Thread BR-Zigbee GW_SUB" ethernet sub-board.
# CDC2NET_ETH_W5500 gates net_eth.c + the esp_eth REQUIRES in main/CMakeLists;
# the in-core esp_eth W5500 driver additionally needs the two ETH_* options
# (IDF 5.5.x still ships the SPI-Ethernet chip drivers in core, removed in 6.0)
# — same trio as sdkconfig.defaults.esp32c6.
CONFIG_CDC2NET_ETH_W5500=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# One artifact for the whole board: the H2's ZBOSS-NCP firmware ships in the
# radio_fw partition and is written over the inter-chip UART at boot when the H2
# runs something else (ot_rcp ab Werk) or a different version.  See radio_flash.h.
CONFIG_CDC2NET_RADIO_FLASH=y

# Console on the native USB-Serial/JTAG, not UART0.  This board's USB-C goes
# straight to the S3's USJ — there is no CH34x bridge like on the YD-ESP32-S3,
# and UART0 only reaches a pin header.  With UART0 as the console, Improv-Serial
# (improv_glue.cpp picks its transport from this very option) would listen on a
# port no user can reach, leaving the captive AP as the only way to onboard WiFi.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- PSRAM: vorhanden und nutzbar, absichtlich AUS -----------------------
# Board-Fakten hardware-verifiziert 2026-07-30 (die Espressif-Doku nennt 8 MB
# Flash / 2 MB PSRAM — dieses Board hat 16 MB Flash und 8 MB Octal-PSRAM):
#   eFuse: PSRAM_CAP=8M, PSRAM_VENDOR=AP_3v3, PSRAM_TEMP=85C
#   Testbuild mit den vier Optionen unten lief sauber hoch:
#     octal_psram: vendor 0x0d (AP), density 0x03 (64 Mbit), good-die Pass
#     esp_psram: Found 8MB PSRAM device
#     esp_psram: Adding pool of 8192K of PSRAM memory to heap allocator
#   -> freier Heap 8.468.148 B statt ~141 KB, Bridge + z2m + Zigbee-Roundtrip
#      im Smoke-Test unauffaellig.
# AUS, weil aktuell nichts davon profitiert: die Bridge-Puffer sind klein, und
# PSRAM auf dem S3 aendert Speicherlayout/Cache-Verhalten neben WiFi+SPI-DMA —
# Risiko ohne Nutzen in einem Produkt-Image. Einschalten, sobald es einen
# Grund gibt (grosse Replay-/Fanning-Puffer), dann aber mit eigener Soak-
# Validierung, nicht nur Smoke-Test.
# FALLE beim Aktivieren: PlatformIO regeneriert firmware/sdkconfig.<env> NICHT,
# wenn nur diese Defaults-Datei ergaenzt wird -> firmware/sdkconfig.zbgw-s3
# vorher loeschen, sonst landen die Optionen nie im Build.
#CONFIG_SPIRAM=y
#CONFIG_SPIRAM_MODE_OCT=y
#CONFIG_SPIRAM_SPEED_80M=y
#CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# --- Flash size: 8 MB, nicht 16 -------------------------------------------
# Das Entwicklungs-Board dieser Firmware traegt 16 MB Flash, Espressifs Doku
# zum ESP Thread-BR/Zigbee-GW nennt 8 MB — und Boards mit 8 MB sind im Feld
# (Issue tostmann/esp-coordinator#11: Bootloop mit
#   "Detected size(8192k) smaller than the size in the binary image header(16384k)").
# Der Bootloader uebernimmt spi_size aus dem Image-Header als ROM-Flashgroesse
# (update_flash_config()); esp_flash_init_default_chip() assertet, wenn der
# erkannte Chip KLEINER ist als der Header — groesser ist unproblematisch.
# 8 MB laeuft daher auf beiden Bestueckungen; das Layout passt bereits
# (letzte Partition radio_fw endet bei 0x6E0000 ~ 6,9 MiB).
# Ueberschreibt sdkconfig.defaults.esp32s3 (16MB), das die anderen S3-Varianten
# weiter nutzen. IDF 5.5.3 kennt KEIN ESPTOOLPY_FLASHSIZE_DETECT.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
